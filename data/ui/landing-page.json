{
  "schemaVersion": 1,
  "pageId": "login-main-menu",
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "themeId": "steamdb-dark-v1",
  "brand": {
    "nameKey": "brand.name"
  },
  "appState": {
    "initialScreenId": "login",
    "authenticatedScreenId": "main-menu",
    "sessionSource": "server-cookie"
  },
  "auth": {
    "provider": "steam-openid",
    "loginPath": "/auth/steam",
    "callbackPath": "/auth/steam/callback",
    "sessionPath": "/api/session",
    "logoutPath": "/auth/logout",
    "profileFields": ["displayName", "steamId", "avatarUrl"],
    "failureStatusKey": "landing.login.failed",
    "sessionErrorStatusKey": "landing.login.sessionError",
    "accountAriaLabelKey": "account.summaryLabel"
  },
  "layout": {
    "kind": "login-to-main-menu-flow",
    "density": "database",
    "allowsCards": false,
    "screens": [
      {
        "id": "login",
        "role": "authentication-entry",
        "headingKey": "landing.heading",
        "bodyKey": "landing.intro",
        "buttonKey": "landing.login.button",
        "pendingStatusKey": "landing.login.pending",
        "successStatusKey": "landing.login.success"
      },
      {
        "id": "main-menu",
        "role": "mode-selection",
        "headingKey": "mainMenu.heading",
        "ariaLabelKey": "mainMenu.ariaLabel"
      },
      {
        "id": "standard-game",
        "role": "gameplay",
        "routePath": "/game/standard",
        "headingKey": "game.standard.heading"
      }
    ],
    "mainMenu": {
      "kind": "horizontal-shift-with-right-description",
      "modeListShift": "left-on-mode-click",
      "descriptionReveal": "slide-from-right-after-click",
      "descriptionContent": "mode-rules-and-records"
    }
  },
  "languageToggle": {
    "labelKey": "language.toggle",
    "options": [
      {
        "locale": "zh-CN",
        "labelKey": "language.zh"
      },
      {
        "locale": "en-US",
        "labelKey": "language.en"
      }
    ]
  },
  "loginButton": {
    "id": "steam-login",
    "provider": "steam",
    "labelKey": "landing.login.button",
    "shape": "capsule",
    "colorToken": "steam-green",
    "pressAnimation": "subtle-press",
    "actionKind": "steam-openid-redirect"
  },
  "mainMenu": {
    "id": "main-menu",
    "modes": [
      {
        "id": "standard-mode",
        "labelKey": "mainMenu.standardMode.button",
        "activeLabelKey": "mainMenu.standardMode.readyButton",
        "startPath": "/game/standard",
        "activeAnimation": "subtle-float",
        "description": {
          "surfaceId": "standard-mode-description",
          "layout": "mode-rules-and-records",
          "sections": [
            {
              "id": "rules",
              "headingKey": "mainMenu.standardMode.description.heading",
              "bodyKey": "mainMenu.standardMode.description.body"
            },
            {
              "id": "filters",
              "headingKey": "mainMenu.standardMode.filters.heading",
              "listItemKeys": [
                "mainMenu.standardMode.filters.item.gameOnly",
                "mainMenu.standardMode.filters.item.sfw",
                "mainMenu.standardMode.filters.item.minReviews"
              ]
            }
          ],
          "records": [
            {
              "id": "high-score",
              "labelKey": "mainMenu.standardMode.records.highScore"
            },
            {
              "id": "best-combo",
              "labelKey": "mainMenu.standardMode.records.bestCombo"
            }
          ]
        }
      }
    ]
  }
}
