{
  "schemaVersion": 1,
  "pageId": "login-main-menu",
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en-US"],
  "themeId": "steamdb-dark-v1",
  "brand": {
    "nameKey": "brand.name"
  },
  "appState": {
    "initialScreenId": "login",
    "authenticatedScreenId": "main-menu",
    "sessionSource": "server-cookie"
  },
  "auth": {
    "provider": "steam-openid",
    "loginPath": "/auth/steam",
    "callbackPath": "/auth/steam/callback",
    "sessionPath": "/api/session",
    "logoutPath": "/auth/logout",
    "profileFields": ["displayName", "steamId", "avatarUrl"],
    "failureStatusKey": "landing.login.failed",
    "sessionErrorStatusKey": "landing.login.sessionError",
    "accountAriaLabelKey": "account.summaryLabel"
  },
  "layout": {
    "kind": "login-to-main-menu-flow",
    "density": "database",
    "allowsCards": false,
    "screens": [
      {
        "id": "login",
        "role": "authentication-entry",
        "headingKey": "landing.heading",
        "bodyKey": "landing.intro",
        "buttonKey": "landing.login.button",
        "pendingStatusKey": "landing.login.pending",
        "successStatusKey": "landing.login.success"
      },
      {
        "id": "main-menu",
        "role": "mode-selection",
        "headingKey": "mainMenu.heading",
        "ariaLabelKey": "mainMenu.ariaLabel"
      },
      {
        "id": "standard-game",
        "role": "gameplay",
        "routePath": "/game/standard",
        "headingKey": "game.standard.heading"
      },
      {
        "id": "guessed-games",
        "role": "history",
        "routePath": "/history/guessed",
        "headingKey": "history.guessed.heading"
      }
    ],
    "mainMenu": {
      "kind": "horizontal-shift-with-right-description",
      "modeListShift": "left-on-mode-click",
      "descriptionReveal": "slide-from-right-after-click",
      "descriptionContent": "mode-rules-and-records"
    },
    "screenTransition": {
      "kind": "fade",
      "durationMs": 160,
      "reducedMotion": "none"
    }
  },
  "languageToggle": {
    "labelKey": "language.toggle",
    "options": [
      {
        "locale": "zh-CN",
        "labelKey": "language.zh"
      },
      {
        "locale": "en-US",
        "labelKey": "language.en"
      }
    ]
  },
  "loginButton": {
    "id": "steam-login",
    "provider": "steam",
    "labelKey": "landing.login.button",
    "shape": "capsule",
    "colorToken": "steam-green",
    "pressAnimation": "subtle-press",
    "actionKind": "steam-openid-redirect"
  },
  "mainMenu": {
    "id": "main-menu",
    "navigation": [
      {
        "id": "guessed-games",
        "labelKey": "mainMenu.guessedGames.button",
        "path": "/history/guessed"
      }
    ],
    "modes": [
      {
        "id": "standard-mode",
        "labelKey": "mainMenu.standardMode.button",
        "activeLabelKey": "mainMenu.standardMode.readyButton",
        "startPath": "/game/standard",
        "activeAnimation": "subtle-float",
        "description": {
          "surfaceId": "standard-mode-description",
          "layout": "mode-rules-and-records",
          "sections": [
            {
              "id": "rules",
              "headingKey": "mainMenu.standardMode.description.heading",
              "bodyKey": "mainMenu.standardMode.description.body"
            },
            {
              "id": "filters",
              "headingKey": "mainMenu.standardMode.filters.heading",
              "listItemKeys": [
                "mainMenu.standardMode.filters.item.gameOnly",
                "mainMenu.standardMode.filters.item.sfw",
                "mainMenu.standardMode.filters.item.minReviews"
              ]
            }
          ],
          "records": [
            {
              "id": "high-score",
              "labelKey": "mainMenu.standardMode.records.highScore"
            },
            {
              "id": "best-combo",
              "labelKey": "mainMenu.standardMode.records.bestCombo"
            }
          ]
        }
      }
    ]
  },
  "guessedGames": {
    "id": "guessed-games",
    "api": {
      "listPath": "/api/standard/guessed-games",
      "clearPath": "/api/standard/guessed-games/clear"
    },
    "layout": {
      "kind": "paged-history-list",
      "allowsCards": false
    },
    "labels": {
      "loadingKey": "history.guessed.loading",
      "emptyKey": "history.guessed.empty",
      "totalKey": "history.guessed.total",
      "pageStatusKey": "history.guessed.pageStatus",
      "previousButtonKey": "history.guessed.previous",
      "nextButtonKey": "history.guessed.next",
      "returnMenuButtonKey": "history.guessed.returnMenu",
      "clearButtonKey": "history.guessed.clear",
      "clearDialogHeadingKey": "history.guessed.clearDialog.heading",
      "clearDialogBodyKey": "history.guessed.clearDialog.body",
      "clearDialogCancelKey": "history.guessed.clearDialog.cancel",
      "clearDialogConfirmKey": "history.guessed.clearDialog.confirm",
      "clearSuccessKey": "history.guessed.clearSuccess",
      "errorKey": "history.guessed.error"
    }
  },
  "standardGame": {
    "id": "standard-game",
    "modeId": "standard-mode",
    "api": {
      "statePath": "/api/standard/state",
      "guessPath": "/api/standard/guess",
      "nextPath": "/api/standard/next",
      "skipShortVideoPath": "/api/standard/skip-short-video",
      "restartPath": "/api/standard/restart"
    },
    "layout": {
      "kind": "video-left-status-right",
      "resultKind": "centered-summary",
      "allowsCards": false
    },
    "video": {
      "hidePrePlayPoster": true
    },
    "input": {
      "name": "reviewCountGuess",
      "type": "integer",
      "min": 50
    },
    "labels": {
      "videoLabelKey": "game.standard.video.label",
      "guessLabelKey": "game.standard.guess.label",
      "guessHintKey": "game.standard.guess.hint",
      "submitButtonKey": "game.standard.submit",
      "nextButtonKey": "game.standard.next",
      "restartButtonKey": "game.standard.restart",
      "returnMenuButtonKey": "game.standard.returnMenu",
      "healthLabelKey": "game.standard.health",
      "scoreLabelKey": "game.standard.score",
      "streakLabelKey": "game.standard.streak",
      "guessNumberLabelKey": "game.standard.guessNumber",
      "gameInfoHeadingKey": "game.standard.gameInfo",
      "reviewCountLabelKey": "game.standard.reviewCount",
      "waitingRevealKey": "game.standard.waitingReveal",
      "resultCorrectKey": "game.standard.result.correct",
      "resultDamagedKey": "game.standard.result.damaged",
      "resultErrorPercentKey": "game.standard.result.errorPercent",
      "resultScoreKey": "game.standard.result.score",
      "loadingKey": "game.standard.loading",
      "gameOverHeadingKey": "game.standard.gameOver",
      "finalScoreLabelKey": "game.standard.finalScore",
      "finalStreakLabelKey": "game.standard.finalStreak",
      "lastGameHeadingKey": "game.standard.lastGame",
      "newHighScoreKey": "game.standard.newHighScore",
      "newBestStreakKey": "game.standard.newBestStreak",
      "noRecordNoticeKey": "game.standard.noRecordNotice"
    },
    "errorMessages": {
      "auth_required": { "messageKey": "game.standard.error.authRequired" },
      "invalid_guess": { "messageKey": "game.standard.error.invalidGuess" },
      "guess_required": { "messageKey": "game.standard.error.guessRequired" },
      "candidate_unavailable": { "messageKey": "game.standard.error.candidateUnavailable" },
      "steam_request_failed": { "messageKey": "game.standard.error.steamRequestFailed" },
      "skip_not_allowed": { "messageKey": "game.standard.error.skipNotAllowed" },
      "state_unavailable": { "messageKey": "game.standard.error.stateUnavailable" }
    }
  }
}
